<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="item"
            type="com.amirbahadoramiri.kalayar.domain.models.TransactionItem" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/STANDARD_48dp"
        android:background="@color/kalayar_item_background_color">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/item_name"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingRight="@dimen/STANDARD_16dp"
            android:paddingLeft="@dimen/STANDARD_8dp"
            android:gravity="right|center_vertical"
            android:textColor="@color/kalayar_text_color"
            android:textSize="@dimen/STANDARD_12sp"
            android:textStyle="bold"
            android:text="@{item.product_name}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_weight="0.4"
            app:layout_constraintLeft_toRightOf="@id/item_price"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:background="@color/kalayar_icon_hint_color"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@id/item_price"
            app:layout_constraintRight_toLeftOf="@id/item_name"
            android:layout_width="0.2dp"
            android:layout_height="0dp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/item_price"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingLeft="@dimen/STANDARD_8dp"
            android:paddingRight="@dimen/STANDARD_8dp"
            android:gravity="center"
            android:textColor="@color/kalayar_text_color"
            android:textSize="@dimen/STANDARD_12sp"
            android:textStyle="bold"
            android:text="@{String.valueOf(item.product_price)}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_weight="0.3"
            app:layout_constraintLeft_toRightOf="@id/item_count"
            app:layout_constraintRight_toLeftOf="@id/item_name"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:background="@color/kalayar_icon_hint_color"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@id/item_count"
            app:layout_constraintRight_toLeftOf="@id/item_price"
            android:layout_width="0.2dp"
            android:layout_height="0dp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/item_count"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingLeft="@dimen/STANDARD_16dp"
            android:paddingRight="@dimen/STANDARD_8dp"
            android:gravity="left|center_vertical"
            android:textColor="@color/kalayar_text_color"
            android:textSize="@dimen/STANDARD_12sp"
            android:textStyle="bold"
            android:text="@{String.valueOf(item.change_amount)}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_weight="0.3"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/item_price"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:background="@color/kalayar_icon_hint_color"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            android:layout_width="0dp"
            android:layout_height="0.2dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>