<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" >

    <androidx.cardview.widget.CardView
        android:id="@+id/maincard"
        app:cardCornerRadius="@dimen/STANDARD_8dp"
        app:cardBackgroundColor="@color/white"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        android:padding="@dimen/STANDARD_8dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="0dp"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent" >

            <androidx.cardview.widget.CardView
                android:layout_marginTop="@dimen/STANDARD_16dp"
                app:layout_constraintTop_toTopOf="parent"
                android:id="@+id/cardview"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardCornerRadius="@dimen/STANDARD_16dp"
                app:cardBackgroundColor="@color/kalayar_item_background_color"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_width="@dimen/STANDARD_64dp"
                android:layout_height="@dimen/STANDARD_64dp" >

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" >

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/imageView"
                        tools:src="@drawable/kalayar_products"
                        android:layout_width="@dimen/STANDARD_36dp"
                        android:layout_height="@dimen/STANDARD_36dp" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.cardview.widget.CardView>

            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/STANDARD_16sp"
                android:layout_marginTop="@dimen/STANDARD_8dp"
                android:layout_marginBottom="@dimen/STANDARD_8dp"
                android:textColor="@color/kalayar_text_color"
                android:id="@+id/textView"
                tools:text="@string/products"
                app:layout_constraintTop_toBottomOf="@id/cardview"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>