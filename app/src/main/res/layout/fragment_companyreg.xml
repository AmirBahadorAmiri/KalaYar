<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background_color"
        android:paddingBottom="64dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/fragment_company_back_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:focusable="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_back" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="32dp"
            android:text="@string/company_register"
            android:textSize="@dimen/PAGE_TITLE"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/fragment_company_back_icon"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@id/fragment_company_back_icon" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/fragment_company_company_name"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="16dp"
            android:background="@drawable/radius_16"
            android:backgroundTint="@color/white"
            android:hint="@string/insert_company_name"
            android:inputType="text"
            android:maxLength="32"
            android:maxLines="1"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:textColor="@color/black"
            android:textColorHint="@color/texthintColor"
            android:textSize="@dimen/MEDIUM_TEXT_SIZE"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fragment_company_back_icon" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/fragment_company_company_address"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:background="@drawable/radius_16"
            android:backgroundTint="@color/white"
            android:hint="@string/insert_company_address"
            android:inputType="text"
            android:maxLength="72"
            android:maxLines="1"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:textColor="@color/black"
            android:textColorHint="@color/texthintColor"
            android:textSize="@dimen/MEDIUM_TEXT_SIZE"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fragment_company_company_name" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/fragment_company_company_website"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:background="@drawable/radius_16"
            android:backgroundTint="@color/white"
            android:hint="@string/insert_company_website"
            android:inputType="textUri"
            android:maxLength="64"
            android:maxLines="1"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:textColor="@color/black"
            android:textColorHint="@color/texthintColor"
            android:textSize="@dimen/MEDIUM_TEXT_SIZE"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fragment_company_company_address" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/fragment_company_company_telephone"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:background="@drawable/radius_16"
            android:backgroundTint="@color/white"
            android:hint="@string/insert_company_telephone"
            android:inputType="phone"
            android:maxLength="24"
            android:maxLines="1"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:textColor="@color/black"
            android:textColorHint="@color/texthintColor"
            android:textSize="@dimen/MEDIUM_TEXT_SIZE"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fragment_company_company_website" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/fragment_company_company_email"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:background="@drawable/radius_16"
            android:backgroundTint="@color/white"
            android:hint="@string/insert_company_email"
            android:inputType="textEmailAddress"
            android:maxLength="32"
            android:maxLines="1"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:textColor="@color/black"
            android:textColorHint="@color/texthintColor"
            android:textSize="@dimen/MEDIUM_TEXT_SIZE"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fragment_company_company_telephone" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/fragment_company_company_instagram"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:background="@drawable/radius_16"
            android:backgroundTint="@color/white"
            android:hint="@string/insert_company_instagram"
            android:inputType="text"
            android:maxLength="32"
            android:maxLines="1"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:textColor="@color/black"
            android:textColorHint="@color/texthintColor"
            android:textSize="@dimen/MEDIUM_TEXT_SIZE"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fragment_company_company_email" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/fragment_company_company_telegram"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:background="@drawable/radius_16"
            android:backgroundTint="@color/white"
            android:hint="@string/insert_company_telegram"
            android:inputType="text"
            android:maxLength="32"
            android:maxLines="1"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:textColor="@color/black"
            android:textColorHint="@color/texthintColor"
            android:textSize="@dimen/MEDIUM_TEXT_SIZE"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fragment_company_company_instagram" />

        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:backgroundTint="@color/main_green"
            android:text="@string/next_step"
            android:textColor="@color/white"
            android:textSize="@dimen/MEDIUM_TEXT_SIZE"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fragment_company_company_telegram" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>