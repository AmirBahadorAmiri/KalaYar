<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/STANDARD_8dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/row_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:textColor="@color/kalayar_text_hint_color"
        android:textSize="@dimen/STANDARD_14sp" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/row_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:textColor="@color/kalayar_text_color"
        android:textSize="@dimen/STANDARD_16sp"
        android:textStyle="bold" />
</RelativeLayout>